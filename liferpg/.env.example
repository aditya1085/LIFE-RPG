# PostgreSQL connection string.
# Locally: postgresql://postgres:postgres@localhost:5432/liferpg
# On Railway: use the DATABASE_URL Railway generates for your Postgres plugin.
DATABASE_URL="postgresql://user:password@localhost:5432/liferpg"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-this-with-a-random-secret"
# Set to your deployed URL in production, e.g. https://your-app.up.railway.app
NEXTAUTH_URL="http://localhost:3000"
